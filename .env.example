# Single VPS baseline (Ubuntu 24.04, 2 vCPU, 8 GB RAM)
BOT_MODE=webhook
TELEGRAM_BOT_TOKEN=your-bot-token
BOT_OWNER_ID=123456789

# Internal service URLs (Docker network)
DATABASE_URL=postgresql://karar:karar_change_me@db:5432/karar_bot
POSTGRES_DB=karar_bot
POSTGRES_USER=karar
POSTGRES_PASSWORD=karar_change_me
REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=redis
QUEUE_NAME=karar-bot-jobs

# Public webhook settings (must be real domain with HTTPS)
WEBHOOK_URL=https://bot.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=replace-with-random-secret
DISABLE_AUTO_WEBHOOK_SET=false

# Runtime ports/listen
BOT_LISTEN_HOST=0.0.0.0
PORT=8080
HEALTHCHECK_PORT=8081
ENABLE_HEALTHCHECK=true

# Worker tuning for this server size (conservative)
WORKER_CONCURRENCY=1
WORKER_BATCH_SIZE=8
WORKER_POLL_INTERVAL=1.0
WORKER_NAME=download-worker
WORKER_HEARTBEAT_TTL_SECONDS=90
JOB_LOCK_TIMEOUT_SECONDS=2400
DOWNLOAD_TIMEOUT_SECONDS=240
# Host path to the Netscape cookies file (mounted read-only into the container).
# REQUIRED if you see "Sign in to confirm you're not a bot" errors from YouTube.
# Steps:
#   1. cp cookies.txt.example cookies.txt
#   2. Export your browser cookies (use "Get cookies.txt LOCALLY" extension) after
#      logging in to YouTube and paste the content into cookies.txt.
#   3. Set COOKIES_FILE=./cookies.txt below (already done here).
# WARNING: Do NOT leave COOKIES_FILE pointing at cookies.txt.example – that file
#          contains no real cookies and will NOT fix authentication errors.
COOKIES_FILE=./cookies.txt
YTDLP_COOKIES_FILE=/app/cookies/cookies.txt
YTDLP_COOKIES_FROM_BROWSER=

# Temporary files
BOT_TEMP_DIR=/tmp/karar-bot
TEMP_RETENTION_HOURS=4

# Upload/rate/log limits
MAX_UPLOAD_FILE_SIZE_MB=49
RATE_LIMIT_REQUESTS_PER_WINDOW=4
RATE_LIMIT_WINDOW_SECONDS=120
RATE_LIMIT_BLOCK_SECONDS=300
LOG_LEVEL=INFO

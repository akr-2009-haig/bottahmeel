BOT_MODE=polling
TELEGRAM_BOT_TOKEN=your-bot-token
BOT_OWNER_ID=123456789
DATABASE_URL=postgresql://postgres:postgres@db:5432/karar_bot
REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=redis
QUEUE_NAME=karar-bot-jobs
WEBHOOK_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=
BOT_LISTEN_HOST=0.0.0.0
PORT=8080
HEALTHCHECK_PORT=8081
ENABLE_HEALTHCHECK=true
BOT_TEMP_DIR=/tmp/karar-bot
TEMP_RETENTION_HOURS=6
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=25
WORKER_CONCURRENCY=1
WORKER_NAME=download-worker
WORKER_HEARTBEAT_TTL_SECONDS=90
JOB_LOCK_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=120

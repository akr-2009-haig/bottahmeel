# deploy/.env.single-server.example
#
# نموذج متغيرات البيئة لنشر الخادم الواحد (Hostinger KVM 8)
# ─────────────────────────────────────────────────────────────
# انسخ هذا الملف إلى ملف .env.production في جذر المشروع:
#   cp deploy/.env.single-server.example .env.production
# ثم عدّل القيم حسب بيئتك الفعلية قبل تشغيل Docker Compose.
# ─────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────

# توكن البوت من BotFather (إلزامي)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرّف Telegram للمالك/المشرف الرئيسي (عدد صحيح)
BOT_OWNER_ID=123456789

# ── وضع التشغيل ──────────────────────────────────────────────────────────────

# وضع تشغيل البوت: webhook في الإنتاج (لا تغيّره إلى polling)
BOT_MODE=webhook

# ── Webhook ───────────────────────────────────────────────────────────────────

# عنوان URL الكامل للنطاق (بدون مسار، بدون شرطة مائلة في النهاية)
WEBHOOK_URL=https://YOUR_DOMAIN

# مسار الـ Webhook (يجب أن يتطابق مع إعداد Nginx في deploy/nginx.conf)
WEBHOOK_PATH=/telegram/webhook

# رمز سري للتحقق من أن الطلبات قادمة من Telegram فعلاً
# أنشئه بأمر مثل: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET_TOKEN=CHANGE_ME_GENERATE_A_STRONG_RANDOM_TOKEN

# ── شبكة الخادم ──────────────────────────────────────────────────────────────

# عنوان الاستماع داخل الحاوية (لا تغيّره)
BOT_LISTEN_HOST=0.0.0.0

# المنفذ الرئيسي للبوت (webhook) – Nginx يعيد توجيهه
PORT=8080

# منفذ فحص الصحة: /healthz  /readyz  /queuez (منفصل عن الـ webhook)
HEALTHCHECK_PORT=8081

# تفعيل خادم فحص الصحة الداخلي
ENABLE_HEALTHCHECK=true

# ── قاعدة البيانات (PostgreSQL) ───────────────────────────────────────────────

# رابط الاتصال بقاعدة البيانات داخل شبكة Docker
# اسم الخدمة "db" هو اسم حاوية PostgreSQL في docker-compose.single-server.yml
DATABASE_URL=postgresql://karar:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/karar_bot

# اسم قاعدة البيانات (يجب أن يتطابق مع POSTGRES_DB)
POSTGRES_DB=karar_bot

# اسم مستخدم قاعدة البيانات (يجب أن يتطابق مع POSTGRES_USER)
POSTGRES_USER=karar

# كلمة مرور قاعدة البيانات (يجب أن تكون قوية في الإنتاج)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis (طابور المهام والـ rate limiting) ────────────────────────────────────

# رابط الاتصال بـ Redis داخل شبكة Docker
REDIS_URL=redis://redis:6379/0

# نوع الخلفية للطابور: redis (موصى به في الإنتاج)
QUEUE_BACKEND=redis

# اسم الطابور
QUEUE_NAME=karar-bot-jobs

# ── Workers (معالجة التنزيلات في الخلفية) ─────────────────────────────────────

# عدد المهام المتزامنة لكل worker واحد
# على KVM 8 مع worker_replicas=2، إجمالي التزامن = 2 × 4 = 8 مهام
WORKER_CONCURRENCY=4

# عدد المهام في كل دفعة (batch) يسحبها الـ worker دفعة واحدة
WORKER_BATCH_SIZE=25

# فاصل زمني للـ polling بالثواني (الوقت بين كل فحص للطابور)
WORKER_POLL_INTERVAL=1.0

# اسم الـ worker (للتمييز في السجلات)
WORKER_NAME=download-worker

# مدة صلاحية نبضة القلب للـ worker بالثواني
# إذا لم يُرسل الـ worker نبضة خلال هذه المدة يُعتبر متوقفاً
WORKER_HEARTBEAT_TTL_SECONDS=90

# مهلة قفل المهمة بالثواني (بعدها تُعاد المهمة للطابور تلقائياً)
JOB_LOCK_TIMEOUT_SECONDS=3600

# اختياري: كوكيز للتحميل من الروابط التي تتطلب جلسة تسجيل دخول
# صيغة ملف Netscape cookies.txt داخل الحاوية (مثال: /run/secrets/yt_cookies.txt)
YTDLP_COOKIES_FILE=/app/cookies/cookies.txt

# بديل اختياري: قراءة الكوكيز من متصفح مثبت داخل الحاوية/الخادم
# أمثلة: firefox:default-release  أو  chrome:Default
YTDLP_COOKIES_FROM_BROWSER=

# ── الملفات المؤقتة ───────────────────────────────────────────────────────────

# مسار تخزين الملفات المؤقتة داخل الحاوية
BOT_TEMP_DIR=/tmp/karar-bot

# عدد ساعات الاحتفاظ بالملفات المؤقتة قبل حذفها تلقائياً
TEMP_RETENTION_HOURS=6

# ── تسجيل الأحداث ─────────────────────────────────────────────────────────────

# مستوى التسجيل: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# الحد الأقصى للطلبات لكل مستخدم خلال نافذة زمنية واحدة
RATE_LIMIT_REQUESTS_PER_WINDOW=5

# مدة النافذة الزمنية بالثواني
RATE_LIMIT_WINDOW_SECONDS=60

# مدة الحجب بعد تجاوز الحد بالثواني
RATE_LIMIT_BLOCK_SECONDS=120
